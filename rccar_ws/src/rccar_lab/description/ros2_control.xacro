<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Other types include sensor and actuator -->
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <!-- plugin is the hardware interface for Controller Manager -->
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <!-- Now specify the joints it will be controlling based on robot URDF -->
        <joint name="fl_wheel_joint">
            <!-- Current values are arbitrary -->
            <command_interface name="velocity">
                <param name="min">-40</param>
                <param name="max">40</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        
        <joint name="fr_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-40</param>
                <param name="max">40</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        
        <joint name="br_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-40</param>
                <param name="max">40</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        
        <joint name="bl_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-40</param>
                <param name="max">40</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>    
          
    </ros2_control>

    <!-- Plugin that tells Gazebo to use ros2 control-->
    <!-- without Gazebo, we'd need to run ros2 run controller_manager ros2_control_node -->
    <gazebo>
        <plugin 
        filename="libgz_ros2_control-system.so"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin"
        >
            <!-- Path to controller yaml -->
            <parameters>$(find rccar_lab)/config/my_controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>